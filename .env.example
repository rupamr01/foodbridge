FOODBRIDGE_SECRET_KEY=replace-with-a-long-random-secret
FOODBRIDGE_DB_HOST=localhost
FOODBRIDGE_DB_PORT=3306
FOODBRIDGE_DB_NAME=foodbridge
FOODBRIDGE_DB_USER=foodbridge
FOODBRIDGE_DB_PASSWORD=replace-with-your-database-password
FOODBRIDGE_COOKIE_SECURE=0

# Optional: verify the cloud MySQL TLS certificate. On Render/Linux, this is
# usually the system CA bundle. Leave blank for local MySQL.
# FOODBRIDGE_DB_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# Optional: free Google sign-in and cloud photo storage through Supabase.
# Leave these blank to keep email/password sign-in and save photos locally.
# Get these from Supabase: Project Settings > API Keys.
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_STORAGE_BUCKET=food-photos

# Email verification (6-digit OTP). Required for new email/password signups.
# This works with any SMTP relay. Brevo Free example:
#   host smtp-relay.brevo.com, port 587, security starttls
#   username = your Brevo login, password = a Brevo SMTP key
# FOODBRIDGE_SMTP_FROM_EMAIL must be a sender verified with the provider.
FOODBRIDGE_SMTP_HOST=smtp-relay.brevo.com
FOODBRIDGE_SMTP_PORT=587
FOODBRIDGE_SMTP_USERNAME=your-brevo-login-email
FOODBRIDGE_SMTP_PASSWORD=your-brevo-smtp-key
FOODBRIDGE_SMTP_FROM_EMAIL=your-verified-sender@example.com
FOODBRIDGE_SMTP_FROM_NAME=FoodBridge
FOODBRIDGE_SMTP_SECURITY=starttls

# Local development only: print the OTP to the server console when email
# delivery is not configured or fails. Never enable this in production.
# FOODBRIDGE_OTP_DEBUG=1
