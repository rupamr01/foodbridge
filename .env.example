FOODBRIDGE_SECRET_KEY=replace-with-a-long-random-secret
FOODBRIDGE_DB_HOST=localhost
FOODBRIDGE_DB_PORT=3306
FOODBRIDGE_DB_NAME=foodbridge
FOODBRIDGE_DB_USER=foodbridge
FOODBRIDGE_DB_PASSWORD=replace-with-your-database-password
FOODBRIDGE_COOKIE_SECURE=0

# Optional: free Google sign-in and cloud photo storage through Supabase.
# Leave these blank to keep email/password sign-in and save photos locally.
# Get these from Supabase: Project Settings > API Keys.
# Legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY also work.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SECRET_KEY=sb_secret_your-key
SUPABASE_STORAGE_BUCKET=food-photos
